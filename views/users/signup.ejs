<% layout("/layouts/boilerplate") %>

    <div class="row">
        <div class="col-6 offset-3 my-3">
            <h1>SignUp on WanderScope</h1>
            <form action="/signup" method="post" class="needs-validation my-3" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">username</label>
                    <input type="text" name="username" id="username" class="form-control" placeholder="Enter user name"
                        required>
                    <div class="valid-feedback">username look goods!</div>
                    <div class="invalid-feedback">Please enter username</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">email</label>
                    <input type="email" name="email" id="email" class="form-control" placeholder="Enter email ID"
                        required>
                    <div class="valid-feedback">email ID look goods!</div>
                    <div class="invalid-feedback">Please enter email ID</div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">password</label>
                    <input type="password" name="password" id="password" class="form-control"
                        placeholder="Enter Strong password" required>
                    <div class="valid-feedback">password look goods!</div>
                    <div class="invalid-feedback">Please enter password</div>
                </div>
                <button class="btn btn-dark mb-3 signup-btn">SignUp</button>
            </form>
        </div>
    </div>