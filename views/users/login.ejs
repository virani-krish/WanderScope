<% layout("/layouts/boilerplate") %>

    <div class="row">
        <div class="col-6 offset-3 my-3">
            <h1>Login to WanderScope</h1>
            <form action="/login" method="post" class="needs-validation my-3" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">username</label>
                    <input type="text" name="username" id="username" class="form-control" placeholder="Enter user name"
                        required>
                    <div class="invalid-feedback">Please enter username</div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">password</label>
                    <input type="password" name="password" id="password" class="form-control"
                        placeholder="Enter Strong password" required>
                    <div class="invalid-feedback">Please enter password</div>
                </div>
                <button class="btn btn-dark mb-3 signup-btn">Login</button>
            </form>
        </div>
    </div>