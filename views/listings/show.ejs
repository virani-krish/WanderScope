<% layout('/layouts/boilerplate') %>

    <div class="row my-3">
        <div class="col-8 offset-2">
            <h3>
                <%= listing.title %>
            </h3>
        </div>


        <div class="card col-6 offset-3 show-card listing-card">
            <img src="<%= listing.image %>" class="card-img-top show-img" alt="Listing Image">
            <div class="card-body">
                <p class="card-text">
                    <%= listing.description %> <br>
                        &#8377; <%= Number(listing.price).toLocaleString("en-IN") %> <br>
                            <%= listing.location %> <br>
                                <%= listing.country %>
                </p>
            </div>
        </div>

        <div class="btns mb-3">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn offset-3 col-1 me-2">Edit</a>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
                <button class="btn btn-dark">Delete</button>
            </form>
        </div>

        <div class="col-6 offset-3 my-3">
            <hr>

            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                <div class="my-3">
                    <label class="form-label" for="rating">Rating</label>
                    <input type="range" class="form-range" min="1" max="5" name="review[rating]" id="rating">
                </div>
                <div class="my-3">
                    <label class="form-label" for="comment">Comments</label>
                    <textarea class="form-control" name="review[comment]" id="comment" cols="30" rows="5"
                        required></textarea>
                    <div class="invalid-feedback">Please add some comments first.</div>
                </div>
                <button class="btn btn-dark">Submit</button>
            </form>

            <hr>
            <h4>All Reviews</h4>

            <div class="row">
                <% for(review of listing.reviews) { %>
                    <div class="card col-5 my-2 mx-3 py-2 px-3">
                        <div class="card-body">
                            <h5 class="card-title">Aman</h5>
                            <p class="card-text">
                                <%= review.comment %>
                            </p>
                            <p class="card-text">
                                <%= review.rating %> ⭐
                            </p>
                        </div>
                        <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                            <button class="btn btn-sm btn-outline-dark my-2">Delete</button>
                        </form>
                    </div>
                    <% } %>
            </div>

        </div>

    </div>